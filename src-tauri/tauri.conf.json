{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CREST",
  "version": "1.1.0",
  "identifier": "com.crest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CREST",
    "copyright": "Copyright © 2026 CREST",
    "category": "Productivity",
    "shortDescription": "Outcome-constrained inference control plane",
    "longDescription": "Local-first desktop application for supervised, evidence-gated agent execution.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/crest-backend.exe"
    ],
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
